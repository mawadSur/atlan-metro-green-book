# expo-router pulls react-dom@19.2.7 transitively (via @expo/ui -> vaul ->
# Radix UI, all web-only), which peer-requires react@^19.2.7 while Expo SDK 56
# pins react@19.2.3. Strict `npm ci` (what EAS Build runs) aborts on that peer
# conflict in the Install dependencies phase. react-dom is unused on native, so
# relaxing peer resolution is safe and is Expo's recommended fix. EAS Build
# automatically honors this project .npmrc.
legacy-peer-deps=true

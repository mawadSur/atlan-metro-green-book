{
  "expo": {
    "name": "Atlan Metro Green Book",
    "slug": "atlan-metro-green-book",
    "version": "1.0.0",
    "scheme": "greenbook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f766e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlangreenbook.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show nearby halal places, mosques, prayer times, and the Qibla direction."
      }
    },
    "android": {
      "package": "com.atlangreenbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show nearby halal places, mosques, prayer times, and the Qibla direction."
        }
      ]
    ]
  }
}

{
  "expo": {
    "name": "Muslim Green Book",
    "slug": "atlan-metro-green-book",
    "version": "1.0.0",
    "scheme": "greenbook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0f766e",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlangreenbook.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show nearby halal places, mosques, prayer times, and the Qibla direction.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atlangreenbook.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show nearby halal places, mosques, prayer times, and the Qibla direction."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0f766e"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39b95685-8ea3-41ba-9580-cbe65d311f73"
      }
    },
    "owner": "kjjungle0"
  }
}
